+#define BWVK_MAX (16u * 1024u * 1024u)
+static long bwvk_error;
+static struct timespec bwvk_started;
+/* Raw syscall preserves the kernel's signed negative errno convention. */
+static long bwvk_trap(long op, const void *ptr, size_t size) {
+    long result;
+    __asm__ volatile("syscall" : "=a"(result)
+        : "a"(0x564b0000UL), "D"(op), "S"(ptr), "d"(size)
+        : "rcx", "r11", "memory");
+    return result;
+}
+static int bwvk_fail(long error) {
+    (void)bwvk_trap(3, NULL, 0);
+    bwvk_error = error < 0 ? error : -EIO;
+    fprintf(stderr, "[webx-icd] VK64 transport error %ld\n", bwvk_error);
+    return -1;
+}
+static int bwvk_read(uint32_t sequence, WebXResponse *out) {
+    if (bwvk_error) return -1;
+    long size;
+    for (;;) {
+        struct timespec now;
+        if (clock_gettime(CLOCK_MONOTONIC, &now)) return bwvk_fail(-errno);
+        if ((now.tv_sec - bwvk_started.tv_sec) * 1000000000LL +
+            now.tv_nsec - bwvk_started.tv_nsec >= 25000000000LL)
+            return bwvk_fail(-ETIMEDOUT);
+        size = bwvk_trap(2, NULL, 0);
+        if (size != -EAGAIN) break;
+        const struct timespec delay = {0, 500000};
+        nanosleep(&delay, NULL);
+    }
+    if (size < 0) return bwvk_fail(size);
+    if (size < 12 || size > BWVK_MAX) return bwvk_fail(-EMSGSIZE);
+    uint8_t *reply = malloc((size_t)size);
+    if (!reply) return bwvk_fail(-ENOMEM);
+    long received = bwvk_trap(2, reply, (size_t)size);
+    if (received != size) { free(reply); return bwvk_fail(received < 0 ? received : -EIO); }
+    WebXResponseHeader header;
+    memcpy(&header, reply, sizeof(header));
+    if (header.seq != sequence || header.len != (uint32_t)size - 12) {
+        free(reply); return bwvk_fail(-EPROTO);
+    }
+    out->result = header.result;
+    out->len = header.len;
+    /* Reuse the bounded response allocation; no second payload allocation. */
+    memmove(reply, reply + 12, header.len);
+    out->data = reply;
+    return 0;
+}
